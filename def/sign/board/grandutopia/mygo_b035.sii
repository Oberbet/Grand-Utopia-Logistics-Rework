sign_template_text : _nameless.108.9324.c040 {
 text: "1. Arr\xc3\xaat obligatoire \xc3\xa0 la gu\xc3\xa9rite.<br>2. Pr\xc3\xa9senter pi\xc3\xa8ce d'identit\xc3\xa9 et documents de transport.<br>3. Couper le moteur pendant l'attente.<br>4. Interdiction de fumer.<br>5. T\xc3\xa9l\xc3\xa9phone interdit en zone class\xc3\xa9e.<br>6. Respect strict des consignes ADR.<br>7. Port des EPI obligatoire."
