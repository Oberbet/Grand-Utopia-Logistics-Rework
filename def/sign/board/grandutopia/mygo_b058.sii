sign_template_text : _nameless.1c8.98a4.7290 {
 text: "Fond\xc3\xa9 en 1994 au coeur de la vall\xc3\xa9e du Bec, Jurassic Junction est le plus grand parc \xc3\xa0 th\xc3\xa8me de Grand Utopia. Construit sur d'anciens gisements fossilif\xc3\xa8res, il accueille chaque ann\xc3\xa9e des milliers de visiteurs venus rencontrer ses c\xc3\xa9l\xc3\xa8bres mascottes : Deepy, le diplodocus bienveillant, Big Al, l'allosaure espi\xc3\xa8gle, et Caveman Kevin, l'homme des cavernes maladroit devenu symbole du parc."
 font_face: "/font/sign/dyxfr_caracteresl4scs.font"
 font_size: &3db851ec
 text_halign: left
 text_valign: top
 font_color: 15263976
 font_opacity: 1
 line_spacing: 0
 letter_spacing: &3ba3d70a
 id: 923140096
 area_name: ""
 area_idx: nil
 coords_l: &3e04bd78
 coords_r: &3ff08fd0
 coords_t: &3fedf1d0
 coords_b: &3f8e23e2
 z_order: 12
 tag: ""
}

sign_template_text : _nameless.1c8.98a4.8b50 {
 text: "Founded in 1994 in the heart of the Bec Valley, Jurassic Junction is Grand Utopia's largest theme park. Built on ancient fossil deposits, it welcomes thousands of visitors every year to meet its famous mascots: Deepy, the benevolent diplodocus, Big Al, the mischievous allosaurus, and Caveman Kevin, the clumsy caveman who has become a park's symbol."
 font_face: "/font/sign/dyxfr_caracteresl4scs.font"
 font_size: &3db851ec
 text_halign: left
 text_valign: top
 font_color: 15263976
 font_opacity: 1
