{
	amount: 100000
	interest_rate: 0.05	# 5 %
	duration: 10	# in weeks
}

bank_loan_data: bank.data.loan3
{
	amount: 200000
	interest_rate: 0.02	# 2 %
	duration: 25	# in weeks
}

bank_loan_data: bank.data.loan4
{
	amount: 500000
	interest_rate: 0.01	# 0.1 %
	duration: 40	# in weeks
}

}
