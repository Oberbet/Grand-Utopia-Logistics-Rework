	state_anim: 4

	# orange_to_red
	state_anim[0]: ""

	# red
	state_anim[1]: "/prefab/level_crossing/fr_right_dwn.pma"

	# orange_to_green
	state_anim[2]: "/prefab/level_crossing/fr_right_up.pma"

	# green
