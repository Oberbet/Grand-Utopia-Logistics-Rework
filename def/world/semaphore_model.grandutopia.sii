SiiNunit
{
# For modders: Please do not modify this file if you want to add a new entry. Create in
# this directory a new file "<base_name>.<idofyourmod>.sii" where <base_name> is name of
# base file without the extension (e.g. "city" for "/def/city.sii") and <idofyourmod> is
# some string which is unlikely to conflict with other mod.

tr_semaphore_model : tr_sem_mdl.single.grandutopia
{

	name: "single-f"

	model_desc: "/model/traffic_light/single_fr.pmd"
	model_coll: "/model/traffic_light/single_fr.pmc"

}

tr_semaphore_model : tr_sem_mdl.single_l.grandutopia
{

	name: "single_l-f"

	model_desc: "/model/traffic_light/single_left_fr.pmd"
	model_coll: "/model/traffic_light/single_left_fr.pmc"

}

tr_semaphore_model : tr_sem_mdl.city.grandutopia
{

	name: "city-f"

	model_desc: "/model/traffic_light/city_fr.pmd"
	model_coll: "/model/traffic_light/city_fr.pmc"

}

tr_semaphore_model : tr_sem_mdl.crossing_r.grandutopia
{

	name: "ab_right_fr"

	model_desc: "/prefab/level_crossing/level_right_anim_fr.pmd"
	model_coll: "/prefab/level_crossing/level_right_anim_fr.pmc"

	state_anim: 4

	# orange_to_red
	state_anim[0]: ""

	# red
	state_anim[1]: "/prefab/level_crossing/fr_right_dwn.pma"

	# orange_to_green
	state_anim[2]: "/prefab/level_crossing/fr_right_up.pma"

	# green
	state_anim[3]: ""

	#sound
	sounds[]: "ROY|/sound/world/semaphore_ets.bank#semaphore/train"
}

