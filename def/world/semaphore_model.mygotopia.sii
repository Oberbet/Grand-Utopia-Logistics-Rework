tr_semaphore_model : tr_sem_mdl.crossing_r.mygotopia
{

	name: "level_right_es"

	model_desc: "/prefab2/level_crossing/level_right_anim_01_es.pmd"
	model_coll: "/prefab2/level_crossing/level_right_anim_01_es.pmc"

	state_anim: 4

	# orange_to_red
	state_anim[0]: ""

	# red
	state_anim[1]: "/prefab2/level_crossing/r_down_ibe.pma"

	# orange_to_green
	state_anim[2]: "/prefab2/level_crossing/r_up_ibe.pma"

	# green
	state_anim[3]: ""

	#sound
    sounds[]: "ROY|/sound/world/semaphore_ets.bank#semaphore/train"
}

tr_semaphore_model : tr_sem_mdl.crossing_r2.mygotopia
{

	name: "level_right_double_es"

	model_desc: "/prefab2/level_crossing/level_right_anim_02_es.pmd"
	model_coll: "/prefab2/level_crossing/level_right_anim_02_es.pmc"

	state_anim: 4

	# orange_to_red
	state_anim[0]: ""

	# red
	state_anim[1]: "/prefab2/level_crossing/r_down_ibe.pma"

	# orange_to_green
	state_anim[2]: "/prefab2/level_crossing/r_up_ibe.pma"

	# green
	state_anim[3]: ""

	#sound
    sounds[]: "ROY|/sound/world/semaphore_ets.bank#semaphore/train"
}

